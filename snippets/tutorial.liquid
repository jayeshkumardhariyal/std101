{% comment %} case {% endcomment %}

{% comment %}
  {{product.type}}
  {% if product.title %}
      {% case product.type %}
      {% when "snowboard" %}
          <p>It is a snowboard</p>

      {% else %}
          <p>Undefined Product type</p>

  {% endcase %}

  {% endif %}
{% endcomment %}

{% comment %} Looping {% endcomment %}

{% comment %}
  {% for product in collection.products limit: 5 %}
    <p
      style=""
      {% if forloop.first %}
        color : blue
      {% elsif forloop.last %}
        color:red
      {% endif %}
    >
      <h1>{{ forloop.index }}: {{ product.title }}</h1>
    </p>
    {% if product.tags.size > 0 %}
      <h2>Tags</h2>
    {% endif %}

    {% for tag in product.tags %}
      {% if tag == 'Sport' %}
        {% continue %}
      {% endif %}
      <li>Product Index: {{ forloop.parentloop.index }} | {{ tag }}</li>
      {% comment %}
        {% if tag == 'Sport' %}
          {% break %}
        {% endif %}
      {% endcomment %}
    {% endfor %}
  {% endfor %}
{% endcomment %}
{% comment %} Paginate {% endcomment %}
{% comment %}
  {% paginate collection.products by 5 %}
    {% for product in collection.products %}
      <p>{{ product.title }}</p>
    {% endfor %}
    {{ paginate | default_pagination }}
  {% endpaginate %}
{% endcomment %}

