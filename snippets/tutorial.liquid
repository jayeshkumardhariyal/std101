{% comment %} Array sorting filters {% endcomment %}

{% comment %}
  {% assign products = collection.products %}
  {% assign productTitles = products | map: 'title' %}

  {% comment %}
    {% for productTitle in productTitles %}
      <p>{{ productTitle }}</p>
    {% endfor %}
  {% endcomment %}

  <p>{{ productTitles | join: '-' }}|</p>

  <p>{{ productTitles.first }}</p>
  <p>{{ productTitles.last }}</p>
  <p>{{ productTitles.size }}</p>

  {% assign priceSortedItems = products | sort: 'price' %}
  {% for priceSortedItem in priceSortedItems %}
    <p>{{ priceSortedItem.title }} -{{ priceSortedItem.price | money }}</p>
  {% endfor %}

  {% assign prices = products | map: 'price' | sort %}
  {% for price in prices %}
    <p>{{ price | money }}</p>
  {% endfor %}

  {% assign sumOfPrice = prices | sum %}
  <p>Total of items price: {{ sumOfPrice }}</p>

  {% assign snowboard = products | where: 'title', 'The Complete Snowboard' | first %}
  {{ snowboard }}
  <p>{{ snowboard.title }}-{{ snowboard.price }}</p>

  {% assign tags = ' ' %}
  {% for product in products %}
    {% for tag in product.tags %}
      {% assign tags = tags | append: tag | append: '  ' %}
    {% endfor %}
  {% endfor %}

  <p>{{ tags | split: ' ' | uniq | join: ' ' }}</p>
{% endcomment %}
